    "global-tint",
    "global-exposure",
    "global-contrast",
    "global-highlights",
    "global-shadows",
    "global-saturation",
    "global-vibrance",
    "global-luminance-curve",
    "uniform-film-grain",
    "uniform-vignette",
    "uniform-bloom",
    "mild-global-sharpening"
  ],
  "forbidden_operations": [
    "background-removal",
    "background-replacement",
    "background-blur",
    "object-removal",
    "object-addition",
    "inpainting",
    "outpainting",
    "canvas-expansion",
    "cropping",
    "reframing",
    "perspective-change",
    "camera-angle-change",
    "depth-of-field-change",
    "face-retouching",
    "skin-retouching",
    "body-reshaping",
    "local-relighting",
    "person-addition",
    "person-removal"
  ],
  "generation_policy": {
    "source_asset_strategy": "immutable-original",
    "regenerate_from": "original_asset",
    "deduplicate_identical_requests": true,
    "backend_only_api_call": true,
    "strict_filter_only": true,
    "default_processing_engine": "native-gpu-filter"
  },
  "processing_policy": {
    "strict_pixel_geometry_preservation": true,
    "default_engine": "native-gpu-filter",
    "preserve_source_dimensions": true,
    "preserve_source_aspect_ratio": true,
    "preserve_source_crop": true,
    "allow_ai_reconstruction": false
  },
  "validation": {
    "reject_when": [
      "Any selected control is not filter_only_compatible.",
      "Any request asks to add, remove, replace, move, reconstruct, repair, blur, or regenerate image content.",
      "The processing engine is generative while strict filter-only mode is active.",
      "The output dimensions differ from the source dimensions in strict filter-only mode."
    ],
    "post_process_assertions": [
      "Output width equals source width.",
      "Output height equals source height.",
      "Only approved global filter parameters were applied."
    ]
  }
}
