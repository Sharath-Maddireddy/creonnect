# Meta / Instagram OAuth
LLM_MODEL_NAME=gpt-4o-mini
LLM_PROVIDER=auto
OPENROUTER_API_KEY=
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Creonnect
OPENROUTER_EMBEDDING_MODEL=

# AI image editor providers (do not reuse the existing text-AI deployment)
IMAGE_EDITOR_AZURE_OPENAI_ENDPOINT=
IMAGE_EDITOR_AZURE_OPENAI_API_KEY=
# Use preview with a Microsoft Foundry project endpoint. This is an API version,
# not the model version shown beside a deployment in the Foundry portal.
IMAGE_EDITOR_AZURE_OPENAI_API_VERSION=preview
IMAGE_EDITOR_AZURE_OPENAI_IMAGE_DEPLOYMENT=
IMAGE_EDITOR_GEMINI_API_KEY=
IMAGE_EDITOR_GEMINI_MODEL=gemini-3.1-flash-image
IMAGE_EDITOR_GENERATION_PROVIDER=gemini
INSTAGRAM_APP_ID=your_facebook_app_id_here
INSTAGRAM_APP_SECRET=your_facebook_app_secret_here
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
CREONNECT_SESSION_SECRET=replace_with_a_long_random_secret_for_cookie_signing
# Local-only testing aid. Never enable in production.
DEV_AUTH_BYPASS=false
DEV_AUTH_BYPASS_ACCOUNT_ID=local-dev-user
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creonnect
CREONNECT_BD_ACCESS_TOKEN=your_creonnect_bd_access_token_here
QUEUE_BACKEND=rq
RQ_QUEUES=account-analysis,single-post-analysis,embedding-ingestion,trend-analysis,content-suggestions,creator-studio
AWS_REGION=ap-south-1
AWS_SQS_ENDPOINT_URL=
AWS_SQS_ACCOUNT_ANALYSIS_QUEUE_URL=
AWS_SQS_SINGLE_POST_ANALYSIS_QUEUE_URL=
AWS_SQS_EMBEDDING_INGESTION_QUEUE_URL=
AWS_SQS_REEL_ANALYSIS_QUEUE_URL=
AWS_SQS_CREATOR_STUDIO_QUEUE_URL=
CREATOR_STUDIO_VISIBILITY_TIMEOUT_SECONDS=1800

# DEPRECATED: replaced by OAuth flow - remove after OAuth is live
# INSTAGRAM_SESSION_ID=

# Redis
REDIS_PASSWORD=replace_with_strong_random_password
REDIS_URL=redis://:replace_with_strong_random_password@localhost:6379/0

